pkgname=oma-hypr-screens
pkgver=0.1.0
pkgrel=1
pkgdesc='Arrange Hyprland monitors: position, rotation, scale, and resolution'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'hyprland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/oma-hypr-screens "$pkgdir/usr/bin/oma-hypr-screens"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/oma-hypr-screens.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/oma-hypr-screens.svg"
  install -Dm644 "$startdir/oma-hypr-screens.desktop" "$pkgdir/usr/share/applications/oma-hypr-screens.desktop"
}
